rules_version = '2';

// WalletQuantso — Firestore security rules.
//
// Principle: every document belongs to exactly one owner and is only ever
// readable/writable by that owner while authenticated. The audit log is
// append-only (no updates, no deletes) so the import history cannot be
// rewritten.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The document being written must belong to the caller.
    function ownsIncoming() {
      return isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // The existing document must belong to the caller.
    function ownsExisting() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ── Acesso restrito (tela Motoristas/Corridas) ─────────────────────────
    // O dono cadastra e-mails em members/{e-mail}. Quem loga com um desses
    // e-mails trabalha nos dados do dono, mas só nas coleções liberadas abaixo.
    function memberEmail() {
      return request.auth.token.email.lower();
    }
    function hasEmail() {
      return isSignedIn() && ("email" in request.auth.token);
    }
    function memberPath() {
      return /databases/$(database)/documents/members/$(memberEmail());
    }
    // O e-mail logado é acesso restrito do dono `ownerId`?
    function isMemberOf(ownerId) {
      return hasEmail() && exists(memberPath()) && get(memberPath()).data.ownerId == ownerId;
    }
    function memberOwnsExisting() {
      return isMemberOf(resource.data.ownerId);
    }
    function memberOwnsIncoming() {
      return isMemberOf(request.resource.data.ownerId);
    }

    // Standard owner-scoped collections: full CRUD for the owner only.
    match /accounts/{id} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /categories/{id} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /costCenters/{id} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /contacts/{id} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /bills/{id} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming() || memberOwnsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /transactions/{id} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /importBatches/{id} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    // Clientes do negócio de entregas (regras de cobrança por cliente).
    // Acesso restrito só lê (para escolher a empresa na tela Motoristas).
    match /clients/{id} {
      allow read: if ownsExisting() || memberOwnsExisting();
      allow delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    // Histórico de cobranças geradas por cliente.
    match /clientBillings/{id} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    // ── Motoristas / Corridas: dono OU acesso restrito do dono ──────────────
    match /drivers/{id} {
      allow read, delete: if ownsExisting() || memberOwnsExisting();
      allow create: if ownsIncoming() || memberOwnsIncoming();
      allow update: if (ownsExisting() || memberOwnsExisting())
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /rides/{id} {
      allow read, delete: if ownsExisting() || memberOwnsExisting();
      allow create: if ownsIncoming() || memberOwnsIncoming();
      allow update: if (ownsExisting() || memberOwnsExisting())
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    // Configuração de pagamento (doc id = uid do dono): só o dono escreve;
    // acesso restrito lê para calcular o título.
    match /driverSettings/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isMemberOf(uid));
      allow create, update: if ownsIncoming() && uid == request.auth.uid;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Acessos restritos (doc id = e-mail em minúsculas): o dono gerencia; o
    // próprio e-mail pode ler o seu doc ao entrar (para saber que é restrito).
    match /members/{email} {
      allow get: if hasEmail() && memberEmail() == email;
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming() && request.resource.data.email == email;
      allow update: if ownsExisting() && ownsIncoming();
    }

    // Audit log: append-only. The owner can create and read their entries but
    // never modify or delete them.
    match /auditLog/{id} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update, delete: if false;
    }

    // Cora auto-sync config, one doc per owner (doc id = uid). The owner manages
    // it from the app; the scheduled job reads/writes it via the Admin SDK,
    // which bypasses these rules. Access is keyed on the doc id (= uid) so that
    // reading a not-yet-created config is allowed instead of denied.
    match /coraSync/{uid} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if ownsIncoming() && uid == request.auth.uid;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
