# Firebase web app configuration (Next.js public env vars).
# Copy this file to `.env.local` and fill in the values from
# Firebase Console → Project settings → Your apps → SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — only if Google Analytics is enabled for the project.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Integração Cora (server-side) — necessária apenas para "Sincronizar Cora".
# Defina estas variáveis no ambiente do servidor (ex.: Vercel → Project →
# Settings → Environment Variables). NUNCA use o prefixo NEXT_PUBLIC_ aqui: são
# segredos e não podem ir para o navegador.

# Client ID da aplicação, obtido no portal do desenvolvedor do Cora.
CORA_CLIENT_ID=
# Certificado e chave. Cole o CONTEÚDO dos arquivos (PEM, com as linhas
# -----BEGIN ...----- / -----END ...-----). Na Vercel dá para colar multilinha.
CORA_CERT=
CORA_KEY=
# Alternativa: em vez de colar o PEM, informe-os em base64 (uma linha):
#   base64 -w0 certificate.pem   e   base64 -w0 private-key.key
# CORA_CERT_BASE64=
# CORA_KEY_BASE64=
# Opcional — base da API. Padrão: https://matls-clients.api.cora.com.br
# Ambiente de testes (stage): https://matls-clients.api.stage.cora.com.br
CORA_BASE_URL=
# Opcional — escopo pedido no token (ex.: account), se o Cora exigir.
CORA_SCOPE=

# Validação do login no servidor. Basta o project id (o mesmo do Firebase);
# não precisa de service account só para verificar quem está chamando.
FIREBASE_PROJECT_ID=
# Opcional — trava a integração a um único e-mail (o seu).
CORA_ALLOWED_EMAIL=

# ── Sincronização automática (agendada) ──────────────────────────────────────
# Necessária APENAS para o modo automático (Vercel Cron grava sem navegador).
# Service account JSON do Firebase em UMA linha (Console → Configurações do
# projeto → Contas de serviço → Gerar nova chave privada).
FIREBASE_SERVICE_ACCOUNT=
# Segredo do cron: a Vercel envia "Authorization: Bearer <CRON_SECRET>" nas
# chamadas agendadas. Use um valor aleatório longo.
CRON_SECRET=
